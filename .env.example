# Copy to .env.local (development) or set in your hosting dashboard (production).
# Never commit real values. None of these are exposed to the browser.

# Public site URL — used for canonical URLs, Open Graph, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://dmvtech.in

# SMTP server used to deliver enquiry-form emails. Without these the form
# reports "not available" and never shows a success message.
SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS (port 465); leave empty to default by port.
SMTP_SECURE=
# Require STARTTLS upgrade (defaults to true when SMTP_SECURE is false).
SMTP_REQUIRE_TLS=
SMTP_USER=
SMTP_PASS=
# Sender shown on the email. Many providers require this to match SMTP_USER's domain. Defaults to SMTP_USER.
SMTP_FROM=

# Where enquiries are delivered. Defaults to info@dmvtech.in.
CONTACT_TO_EMAIL=
# Optional second recipient.
CONTACT_CC_EMAIL=
