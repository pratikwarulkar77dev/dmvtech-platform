# Copy to .env.local (development) or set these in your hosting dashboard (production).
# Never commit real values. None of these are exposed to the browser except NEXT_PUBLIC_*.
# See SMTP_SETUP.md. Blank values are treated as "not set".

# Public site URL, used for canonical URLs, Open Graph, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://dmvtech.in

# ---- SMTP (server-side only). Leave blank until you have real credentials. ----
# The email button on the enquiry forms stays disabled until SMTP_HOST, SMTP_USER and SMTP_PASS are set.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# true = implicit TLS (use with port 465). false = STARTTLS (use with port 587). Blank = chosen by port.
SMTP_SECURE=true
# true = refuse to send unless the connection is upgraded to TLS. Blank = true when SMTP_SECURE is not true.
SMTP_REQUIRE_TLS=false
SMTP_USER=pratikwarulkar5@gmail.com
SMTP_PASS=Pratik@77%
# Sender shown on the email. Must normally be (or be allowed by) SMTP_USER. Blank = SMTP_USER.
SMTP_FROM=pratikwarulkar5@gmail.com

# Where enquiries are delivered. Blank = info@dmvtech.in.
CONTACT_TO_EMAIL=pratikwarulkar5@gmail.com
# Optional second recipient, e.g. info.dmvsoft@gmail.com.
CONTACT_CC_EMAIL=info.dmvsoft@gmail.com.

# ---- Provider presets (copy the lines you need into the values above) ----
# Gmail / Google Workspace (needs 2-Step Verification + an App Password):
#   SMTP_HOST=smtp.gmail.com   SMTP_PORT=587   SMTP_SECURE=false   SMTP_REQUIRE_TLS=true
#   SMTP_USER=<your Gmail address>   SMTP_PASS=<16-character app password>   SMTP_FROM=<same Gmail address>
# Hostinger / domain email:
#   SMTP_HOST=smtp.hostinger.com   SMTP_PORT=465   SMTP_SECURE=true
#   SMTP_USER=<mailbox, e.g. info@your-domain>   SMTP_PASS=<mailbox password>   SMTP_FROM=<same mailbox>
